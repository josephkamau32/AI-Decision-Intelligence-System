# ============================================================================
# Environment Configuration for AI Decision Intelligence System
# ============================================================================
# Copy this file to .env and fill in the actual values
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL database connection string (optional for current version)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/decisera_db

# ============================================================================
# API KEYS & EXTERNAL SERVICES
# ============================================================================

# Google Gemini API Key (REQUIRED for AI Copilot functionality)
# Get your API key from: https://makersuite.google.com/app/apikey
# The AI Copilot will not work without this key
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (optional, for future features)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application name
APP_NAME=Decisera API

# Debug mode (set to False in production)
# When True: detailed error messages, CORS allows all origins
# When False: generic error messages, restricted CORS
DEBUG_MODE=False
DEBUG=False

# API version
VERSION=1.0.0

# API prefix for all endpoints
API_V1_PREFIX=/api/v1

# Environment (development, staging, production)
ENVIRONMENT=development

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT Secret key (IMPORTANT: Use a strong random key in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_characters

# JWT algorithm
JWT_ALGORITHM=HS256

# JWT expiration time (in minutes)
JWT_EXPIRATION_MINUTES=30

# Allowed CORS origins (comma-separated list)
# In production, specify exact origins: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================

# Directory for uploaded files
UPLOAD_DIR=uploads

# Maximum upload size in bytes (100MB = 104857600)
MAX_UPLOAD_SIZE=104857600

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=csv,xlsx,json,parquet

# ============================================================================
# MLFLOW TRACKING
# ============================================================================

# MLflow tracking URI
MLFLOW_TRACKING_URI=file:./mlops/experiments

# MLflow experiment name
MLFLOW_EXPERIMENT_NAME=Decisera

# ============================================================================
# REDIS & CELERY (for background tasks)
# ============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Celery broker URL
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# RATE LIMITING
# ============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=True

# Requests per minute limit
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# CACHING
# ============================================================================

# Enable caching
CACHE_ENABLED=True

# Cache TTL in seconds (300 = 5 minutes)
CACHE_TTL=300

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (optional, leave empty to log only to console)
LOG_FILE=logs/app.log

# Use JSON formatting for logs (useful for log aggregation)
LOG_JSON_FORMAT=False

# ============================================================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================================================
# 1. Set DEBUG=False in production
# 2. Use a strong SECRET_KEY (generate with secrets.token_urlsafe(32))
# 3. Configure DATABASE_URL for persistent storage
# 4. Set specific ALLOWED_ORIGINS (not *)
# 5. Configure GOOGLE_API_KEY for AI Copilot functionality
# 6. Set ENVIRONMENT=production
# 7. Enable HTTPS/TLS
# 8. Configure proper logging (LOG_FILE)
# 9. Set up Redis for caching and background tasks
# 10. Review and adjust rate limits
# ============================================================================