# Environment variables template for AI Decision Intelligence System
# Copy this file to .env and fill in the actual values

# Database configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
# Add other API keys as needed

# Application settings
DEBUG=False
SECRET_KEY=your_secret_key_here
APP_NAME=AI Decision Intelligence System API
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# File upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=104857600

# MLflow
MLFLOW_TRACKING_URI=file:./mlops/experiments
MLFLOW_EXPERIMENT_NAME=AI Decision Intelligence

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Other configurations
# Add any additional environment variables required for the system